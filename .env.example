# ─────────────────────────────────────────────────────────────
# Copie para .env.local e preencha.  `cp .env.example .env.local`
#
# O .env.local NÃO vai para o git. O que está aqui é o modelo.
# ─────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────
# Domínio final da campanha. Sem barra no fim.
#
# É esta variável que decide se o site pode ser indexado pelo Google:
# em `localhost` e em `*.vercel.app` o robots.txt manda ignorar, porque
# uma cópia de trabalho indexada concorre com a oficial na busca pelo
# nome do candidato. Ver lib/config.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ─────────────────────────────────────────────────────────────
# SUPABASE
#
# Enquanto estas variáveis estiverem vazias, o projeto roda 100% com
# os dados locais de data/*.json e com os textos de content/copy.ts.
# O painel abre em modo de leitura. NADA QUEBRA SEM BANCO — é assim
# de propósito, para o site poder existir antes da infraestrutura.
#
# As três chaves ficam em Supabase ▸ Project Settings ▸ API.
# Antes delas, rodar sql/01-instalacao.sql e sql/02-seed-municipios.sql.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ NUNCA prefixar com NEXT_PUBLIC. Esta chave passa por cima de toda
#    a segurança do banco. Ela é lida em um arquivo só,
#    lib/supabase/admin.ts, que tem `import 'server-only'` no topo: se
#    algum componente de cliente importar por engano, o build quebra
#    em vez de vazar.
SUPABASE_SERVICE_ROLE_KEY=""


# ─────────────────────────────────────────────────────────────
# PAINEL
# ─────────────────────────────────────────────────────────────
# Senha única de acesso ao /painel. Duas ou três pessoas da campanha
# usam. Trocar depois é só trocar aqui e republicar.
#
# ⚠️ NÃO PUBLIQUE COM A SENHA DE FÁBRICA. Quem entra no painel edita o
#    CNPJ que sai no rodapé da propaganda eleitoral.
PAINEL_SENHA="troque-esta-senha"

# O segredo que assina o cookie de sessão. Gere um:
#   openssl rand -hex 32
#
# ⚠️ FALHA FECHADO: sem esta variável o painel não entra. É proposital
#    — um segredo padrão em produção é o mesmo que não ter segredo.
PAINEL_SESSION_SECRET=""


# ─────────────────────────────────────────────────────────────
# CONFORMIDADE ELEITORAL
# ─────────────────────────────────────────────────────────────
# A partir deste instante os CTAs de campanha saem do ar sozinhos.
#
# É em UTC. Meia-noite em Brasília é T03:00:00Z. Em Rondônia, no Acre
# e no Amazonas, some mais uma ou duas horas conforme o fuso.
#
# Vazio = nunca sai do ar. Preencha: tirar CTA do ar na hora certa não
# pode depender de alguém lembrar num domingo de manhã.
NEXT_PUBLIC_SILENCIO_ELEITORAL_EM=""

# Os dados legais (CNPJ, nome na urna, cargo, partido, coligação,
# comitê) NÃO ficam aqui: ficam no painel, em Identidade ▸ Rodapé.
# Corrigir um dado errado em campanha não pode depender de deploy.


# ─────────────────────────────────────────────────────────────
# ANALYTICS
# ─────────────────────────────────────────────────────────────
# Só preencher se houver tráfego pago. Vazio = o pixel não carrega.
#
# ⚠️ LIGAR O PIXEL EXIGE TROCAR O TEXTO DA POLÍTICA DE PRIVACIDADE.
#    O item "O que medimos" passa a ser falso. A tela Painel ▸ Tráfego
#    entrega o parágrafo substituto pronto para colar.
#
# O pixel também pode ser configurado pelo painel, junto da Conversions
# API — que é o caminho recomendado, porque não exige deploy.
NEXT_PUBLIC_META_PIXEL_ID=""
